---
import Base from "../layouts/Base.astro";
import { copy, links, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<Base title={t.title} description={t.description} lang={lang} path={lang === "uk" ? "/uk/" : "/"}>
  <header class="block">
    <div class="wrap">
      <div class="bar">
        <a href={lang === "uk" ? "/uk/" : "/"}>nazarii.dev</a>
        <div class="right">
          <span>{t.city}, <span id="clock" data-tz="Europe/Kyiv">--:--</span></span>
          <a href={t.switchHref} hreflang={lang === "uk" ? "en" : "uk"} aria-label={t.switchLabel}>{t.switchText}</a>
        </div>
      </div>
      <h1 id="name" aria-label={t.name}>
        <span class="glitch" data-text={t.name} aria-hidden="true">{t.name}</span>
      </h1>
    </div>
  </header>

  <main class="wrap letter">
    {
      t.sections.map((s) => {
        const photo = "photo" in s ? s.photo : null;
        return <div class:list={["para", { "with-photo": photo, "photo-left": photo === "kyoto" }]}>
          <span class="tag">
            <span class={`e e-${s.kind}`} aria-hidden="true">
              {s.emoji}
            </span>
            {s.tag}
          </span>
          <div class="text">
            {s.html.map((h) => (
              <p set:html={h} />
            ))}
          </div>
          {photo && (
            <figure class="photo">
              <img
                src={photo === "kyoto" ? "/images/kyoto.png" : "/images/drums-700.webp"}
                srcset={photo === "kyoto" ? undefined : "/images/drums-440.webp 440w, /images/drums-700.webp 700w"}
                sizes={photo === "kyoto" ? undefined : "(max-width: 44rem) 90vw, 15rem"}
                width={photo === "kyoto" ? 720 : 700}
                height={photo === "kyoto" ? 1280 : 875}
                alt={photo === "kyoto" ? t.kyotoPhotoAlt : t.photoAlt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}
        </div>
      })
    }
  </main>

  <footer class="wrap">
    <div class="reach">
      <span class="tag"><span class="e e-wave" aria-hidden="true">👋</span>{t.hi.tag}</span>
      <div>
        <div class="mail">me@nazarii.dev</div>
        <nav aria-label="Elsewhere">
          {links.map((l) => <a href={l.href}>{l.name}</a>)}
        </nav>
        <p class="small">{t.hi.small}</p>
      </div>
    </div>
  </footer>
</Base>

<style>
  .letter {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 3rem;
    display: grid;
    gap: 1.6rem;
  }
  .para {
    display: grid;
    grid-template-columns: 9rem minmax(0, 36rem);
    gap: 0.25rem 2.5rem;
  }
  .para.with-photo {
    grid-template-columns: 9rem minmax(0, 36rem) minmax(0, 15rem);
  }
  .para.photo-left {
    grid-template-columns: 9rem minmax(0, 36rem);
  }
  .photo-left .text {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .photo-left .photo {
    grid-column: 1;
    grid-row: 2;
    margin-top: 0.35rem;
  }
  .tag {
    display: flex;
    align-items: center;
    align-self: start;
    gap: 0.5rem;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--muted);
    padding-top: 0.32rem;
  }
  .text {
    min-width: 0;
  }
  .text :global(p) {
    margin: 0;
    font-size: clamp(1.1rem, 1.02rem + 0.35vw, 1.28rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .text :global(p + p) {
    margin-top: 0.9rem;
  }
  .text :global(a) {
    color: var(--ink);
    text-decoration: none;
    padding-inline: 0.06em;
    background: linear-gradient(transparent 60%, var(--hi) 60%);
  }
  .text :global(a:hover) {
    background: var(--hi);
  }
  .photo {
    margin: 0.35rem 0 0;
    align-self: start;
  }
  .photo img {
    width: 100%;
    border-radius: 4px;
  }

  .reach {
    border-top: 1px solid var(--rule);
    padding-block: 1.6rem 3rem;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.4rem 2.5rem;
  }
  .reach .tag {
    padding-top: 0.3rem;
  }
  .mail {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
    letter-spacing: -0.02em;
    user-select: all;
  }
  .reach nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    margin-top: 0.4rem;
  }
  .small {
    margin: 1.6rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* emoji come alive on hover (desktop) or tap (phone) */
  .e {
    display: inline-block;
    font-size: 1.15rem;
    line-height: 1;
    transform-origin: 50% 70%;
  }
  .e-wave {
    transform-origin: 70% 80%;
  }
  .e-coffee {
    position: relative;
  }
  .e-coffee::before {
    content: "~";
    position: absolute;
    left: 30%;
    top: -0.55em;
    font-size: 0.8em;
    color: var(--muted);
    opacity: 0;
  }
  :global(.live) .e-tool { animation: tool 0.7s ease-in-out; }
  :global(.live) .e-drum { animation: drum 0.5s ease-out 2; }
  :global(.live) .e-globe { animation: globe 1.2s ease-in-out; }
  :global(.live) .e-coffee::before { animation: steam 1.4s ease-out 2; }
  :global(.live) .e-write { animation: write 0.8s ease-in-out; }
  :global(.live) .e-wave { animation: wave 0.9s ease-in-out; }
  @keyframes tool { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-25deg); } 60% { transform: rotate(18deg); } }
  @keyframes drum { 0% { transform: translateY(0) scale(1); } 25% { transform: translateY(2px) scale(1.18, 0.86); } 55% { transform: translateY(-3px) scale(0.95, 1.08); } 100% { transform: none; } }
  @keyframes globe { 0%, 100% { transform: rotate(0); } 35% { transform: rotate(-14deg); } 70% { transform: rotate(10deg); } }
  @keyframes steam { 0% { opacity: 0; transform: translateY(4px); } 30% { opacity: 0.9; } 100% { opacity: 0; transform: translate(2px, -10px); } }
  @keyframes write { 0%, 100% { transform: translate(0, 0) rotate(0); } 20% { transform: translate(3px, 1px) rotate(-6deg); } 40% { transform: translate(-2px, 0) rotate(4deg); } 60% { transform: translate(3px, 1px) rotate(-6deg); } 80% { transform: translate(-1px, 0) rotate(2deg); } }
  @keyframes wave { 0%, 100% { transform: rotate(0); } 15% { transform: rotate(18deg); } 30% { transform: rotate(-10deg); } 45% { transform: rotate(16deg); } 60% { transform: rotate(-6deg); } 75% { transform: rotate(10deg); } }

  @media (max-width: 58rem) {
    .para.with-photo {
      grid-template-columns: 9rem minmax(0, 36rem);
    }
    .para.with-photo .photo {
      grid-column: 2;
      max-width: 20rem;
    }
    .para.photo-left .photo {
      grid-column: 1;
      max-width: 9rem;
    }
  }
  @media (max-width: 44rem) {
    .para,
    .para.with-photo,
    .reach {
      grid-template-columns: minmax(0, 1fr);
    }
    .para.with-photo .photo {
      grid-column: 1;
      max-width: 22rem;
    }
    .photo-left .text,
    .photo-left .photo {
      grid-column: 1;
      grid-row: auto;
    }
    .para.photo-left .photo {
      margin: 0.35rem 0 0;
      width: min(65%, 15rem);
      max-width: 15rem;
    }
    .tag,
    .reach .tag {
      padding-top: 0;
    }
  }
</style>

<script is:inline>
  (() => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Lviv time, refreshed every 20 seconds.
    const clock = document.getElementById("clock");
    if (clock) {
      const fmt = new Intl.DateTimeFormat("en-GB", { timeZone: clock.dataset.tz, hour: "2-digit", minute: "2-digit" });
      const tick = () => (clock.textContent = fmt.format(new Date()));
      tick();
      setInterval(tick, 20000);
    }

    // Name: katakana flickers in, glitches, then resolves letter by letter into the name.
    // A plain timer, so it still resolves in a background tab.
    const el = document.querySelector("#name .glitch");
    if (el) {
      const target = el.dataset.text;
      const kana = "ナザリー・クリモク";
      const pool = "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワン";
      const rand = () => pool[(Math.random() * pool.length) | 0];
      const set = (s) => {
        el.textContent = s;
        el.dataset.text = s;
      };
      let running = false;
      const play = () => {
        if (reduce || running) return;
        running = true;
        el.classList.add("on", "jp");
        set(kana);
        const t0 = Date.now();
        const hold = 520, per = 70;
        const id = setInterval(() => {
          const t = Date.now() - t0;
          if (t < hold) {
            if (Math.random() < 0.5) set(kana.split("").map((c) => (Math.random() < 0.18 ? rand() : c)).join(""));
            return;
          }
          el.classList.remove("jp");
          const k = Math.floor((t - hold) / per);
          if (k >= target.length) {
            clearInterval(id);
            set(target);
            el.classList.remove("on");
            running = false;
            return;
          }
          set(target.split("").map((c, i) => (i < k || c === " " ? c : rand())).join(""));
        }, 40);
      };
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => setTimeout(play, 150));
      document.getElementById("name").addEventListener("mouseenter", play);
    }

    // Emoji: pointing at a paragraph, or tapping it, plays its emoji once.
    document.querySelectorAll(".para, .reach").forEach((row) => {
      const go = () => {
        row.classList.remove("live");
        void row.offsetWidth;
        row.classList.add("live");
      };
      row.addEventListener("mouseenter", go);
      row.addEventListener("touchstart", go, { passive: true });
      row.addEventListener("animationend", () => row.classList.remove("live"));
    });
  })();
</script>
