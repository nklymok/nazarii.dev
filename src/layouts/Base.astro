---
interface Props {
  title: string;
  description: string;
  lang?: "en" | "uk";
  path?: string;
  home?: "en" | "uk";
}
const { title, description, lang = "en", path = "/", home } = Astro.props;
const site = "https://nazarii.dev";
const og = `${site}/${lang === "uk" ? "og-uk.png" : "og-en.png"}`;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site}/#person`,
  name: "Nazarii Klymok",
  alternateName: "Назарій Климок",
  url: `${site}/`,
  image: `${site}/images/drums-700.webp`,
  jobTitle: "Engineering Lead",
  worksFor: { "@type": "Organization", name: "BotsCrew", url: "https://botscrew.com" },
  address: { "@type": "PostalAddress", addressLocality: "Lviv", addressCountry: "UA" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Lviv Polytechnic National University" },
  knowsLanguage: ["uk", "en", "ja"],
  knowsAbout: ["AI agents", "Large language models", "Software engineering", "Engineering leadership"],
  email: "mailto:me@nazarii.dev",
  sameAs: [
    "https://www.linkedin.com/in/nklymok/",
    "https://github.com/nklymok",
    "https://t.me/nklymok",
    "https://instagram.com/je_suis_naz",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${path}`} />
    <link rel="alternate" hreflang="en" href={`${site}/`} />
    <link rel="alternate" hreflang="uk" href={`${site}/uk/`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}${path}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3a4bd0" />
    <script is:inline define:vars={{ home }}>
      // The visitor's language choice lives in localStorage, so it follows them to 404s and posts.
      // On a homepage, a stored choice (or, the first time, a Ukrainian browser) picks the version.
      (() => {
        let pref = null;
        try { pref = localStorage.getItem("nazarii.lang"); } catch (e) {}
        if (!pref && (navigator.language || "").toLowerCase().startsWith("uk")) pref = "uk";
        window.__lang = pref || home || "en";
        if (home && pref && pref !== home) location.replace(pref === "uk" ? "/uk/" : "/");
      })();
    </script>

    <meta name="author" content="Nazarii Klymok" />
    <link rel="sitemap" href="/sitemap.xml" />
    {home && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <link rel="preload" href="/fonts/FixelDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FixelText-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Fixel by MacPaw and AlfaBravo, SIL Open Font License 1.1 (see /fonts/OFL.txt). */
  @font-face { font-family: "Fixel Display"; font-weight: 700; font-display: swap; src: url("/fonts/FixelDisplay-Bold.woff2") format("woff2"); }
  @font-face { font-family: "Fixel Display"; font-weight: 600; font-display: swap; src: url("/fonts/FixelDisplay-SemiBold.woff2") format("woff2"); }
  @font-face { font-family: "Fixel Text"; font-weight: 400; font-display: swap; src: url("/fonts/FixelText-Regular.woff2") format("woff2"); }
  @font-face { font-family: "Fixel Text"; font-weight: 500; font-display: swap; src: url("/fonts/FixelText-Medium.woff2") format("woff2"); }

  /* Layout: a blue block with the name, then a letter in one column with small labels in the left margin. */
  :root {
    --paper: #ffffff;
    --ink: #17181c;
    --muted: #6c6f78;
    --rule: #e5e6ea;
    --block: #3a4bd0;
    --block-ink: #fff3c4;
    --link: #2f40b8;
    --hi: #ffe58a;
    --f-display: "Fixel Display", "Helvetica Neue", Arial, sans-serif;
    --f-text: "Fixel Text", "Helvetica Neue", Arial, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #121317;
      --ink: #e9e9e6;
      --muted: #9b9da6;
      --rule: #26282d;
      --block: #2c3aa6;
      --block-ink: #ffefb3;
      --link: #aab7ff;
      --hi: #5a4a12;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --paper: #121317;
    --ink: #e9e9e6;
    --muted: #9b9da6;
    --rule: #26282d;
    --block: #2c3aa6;
    --block-ink: #ffefb3;
    --link: #aab7ff;
    --hi: #5a4a12;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  [hidden] {
    display: none !important;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--f-text);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  :focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .wrap {
    max-width: 66rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  /* the blue block */
  .block {
    background: var(--block);
    color: var(--block-ink);
  }
  .block .wrap {
    padding-block: clamp(1.1rem, 3vw, 1.6rem) clamp(2.5rem, 7vw, 4.5rem);
    display: grid;
    gap: clamp(2.5rem, 8vw, 5rem);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.875rem;
  }
  .bar a,
  .bar span {
    color: inherit;
    opacity: 0.85;
  }
  .bar a {
    text-decoration: none;
  }
  .bar a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .bar .right {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }
  .block h1 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 1.4rem + 6.2vw, 6.25rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  /* name glitch: katakana flickers in, then resolves into the name */
  .glitch {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .glitch.on::before,
  .glitch.on::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glitch.on::before {
    color: #ff6fae;
    transform: translate(-0.04em, 0.01em);
    animation: slice-a 0.18s steps(2) infinite;
    mix-blend-mode: screen;
  }
  .glitch.on::after {
    color: #6ff3ff;
    transform: translate(0.04em, -0.01em);
    animation: slice-b 0.22s steps(2) infinite;
    mix-blend-mode: screen;
  }
  @media (max-width: 22rem) {
    .glitch {
      white-space: normal;
    }
  }
  .glitch.jp {
    font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "Noto Sans JP", var(--f-display);
    letter-spacing: 0;
  }
  @keyframes slice-a {
    0% { clip-path: inset(0 0 60% 0); }
    50% { clip-path: inset(20% 0 45% 0); }
    100% { clip-path: inset(5% 0 70% 0); }
  }
  @keyframes slice-b {
    0% { clip-path: inset(55% 0 0 0); }
    50% { clip-path: inset(40% 0 20% 0); }
    100% { clip-path: inset(65% 0 5% 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
