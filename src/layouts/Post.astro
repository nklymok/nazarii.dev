---
import Base from "./Base.astro";
const { frontmatter, url } = Astro.props;
const date = new Date(frontmatter.date);
const lang = frontmatter.lang === "uk" ? "uk" : "en";
---

<Base title={frontmatter.title} description={frontmatter.description} lang={lang} path={url ?? "/blog/"}>
  <header class="block slim">
    <div class="wrap">
      <div class="bar">
        <a href={lang === "uk" ? "/uk/" : "/"}>nazarii.dev</a>
        <a href="/blog/">{lang === "uk" ? "Тексти" : "Writing"}</a>
      </div>
    </div>
  </header>

  <article class="wrap post">
    <header class="post-head">
      <time datetime={date.toISOString().slice(0, 10)}>
        {date.toLocaleDateString(lang === "uk" ? "uk-UA" : "en-GB", { day: "numeric", month: "long", year: "numeric" })}
      </time>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="dek">{frontmatter.description}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer class="post-foot">
      <a href={lang === "uk" ? "/uk/" : "/"}>← nazarii.dev</a>
    </footer>
  </article>
</Base>

<style>
  .block.slim .wrap {
    padding-block: clamp(1.1rem, 3vw, 1.6rem);
    gap: 0;
  }
  .post {
    max-width: 44rem;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 4rem;
  }
  .post-head {
    display: grid;
    gap: 0.8rem;
    padding-bottom: 1.6rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  time {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .post-head h1 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .dek {
    margin: 0;
    font-size: 1.2rem;
    color: var(--muted);
  }
  .prose {
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.7;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
  }
  .prose :global(ul) {
    padding-left: 1.2em;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(h4) {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 2.2em 0 0.7em;
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(transparent 60%, var(--hi) 60%);
  }
  .prose :global(a:hover) {
    background: var(--hi);
  }
  .prose :global(figure) {
    margin: 1.8em 0;
    display: grid;
    gap: 0.6rem;
    justify-items: center;
  }
  .prose :global(figure img) {
    border: 1px solid var(--rule);
    border-radius: 4px;
    max-height: 32rem;
    width: auto;
  }
  .prose :global(figcaption) {
    font-size: 0.875rem;
    color: var(--muted);
    text-align: center;
    max-width: 50ch;
  }
  .post-foot {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }
</style>
