---
import Base from "../../layouts/Base.astro";

const posts = Object.values(import.meta.glob("./*.md", { eager: true })) as any[];
posts.sort((a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date));
---

<Base title="Writing · Nazarii Klymok" description="Longer posts by Nazarii Klymok, mostly in Ukrainian." path="/blog/">
  <header class="block slim">
    <div class="wrap">
      <div class="bar">
        <a href="/">nazarii.dev</a>
        <span>Writing · Тексти</span>
      </div>
    </div>
  </header>
  <main class="wrap list">
    <ol>
      {
        posts.map((p) => (
          <li>
            <time>{new Date(p.frontmatter.date).toISOString().slice(0, 10)}</time>
            <a href={p.url} lang={p.frontmatter.lang}>
              {p.frontmatter.title}
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<style>
  .block.slim .wrap {
    padding-block: clamp(1.1rem, 3vw, 1.6rem);
    gap: 0;
  }
  .list {
    max-width: 44rem;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 4rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
    font-size: 1.15rem;
  }
  time {
    color: var(--muted);
    font-size: 0.875rem;
    padding-top: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  li a {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(transparent 60%, var(--hi) 60%);
    justify-self: start;
  }
  @media (max-width: 30rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
